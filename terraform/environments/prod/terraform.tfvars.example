# このファイルを terraform.tfvars にコピーし、ローカルで実値へ置き換える。
# terraform.tfvars は .gitignore 対象。
project_id                 = "replace-with-project-id"
region                     = "asia-northeast1"
vertex_ai_location         = "global"
resource_prefix            = "stock"
github_repository_id       = "123456789"
github_repository_owner_id = "12345678"
github_ref                 = "refs/heads/main"
github_workflow_refs = [
  "your-org/your-backend-repository/.github/workflows/cd-api.yaml@refs/heads/main",
  "your-org/your-backend-repository/.github/workflows/cd-batch.yaml@refs/heads/main",
  "your-org/your-backend-repository/.github/workflows/cd-migrate.yaml@refs/heads/main",
]
db_name = "app"
db_user = "appuser"

# 既存環境をrepository名ベースのWIFから移行する最初のapplyだけ有効化する。
# enable_github_wif_legacy_repository = true
# github_repository                   = "your-org/your-backend-repository"

# 手動投入したSecretの有効な数値versionを指定する。値そのものは記載しない。
manual_secret_versions = {
  TWELVE_DATA_API_KEY  = "1"
  GOOGLE_CLIENT_ID     = "1"
  GOOGLE_CLIENT_SECRET = "1"
  GITHUB_CLIENT_ID     = "1"
  GITHUB_CLIENT_SECRET = "1"
}

# 緊急rollbackでTerraform管理Secretを旧versionへ戻す場合だけ設定し、復旧後に削除する。
# managed_secret_version_overrides = { DB_PASSWORD = "1" }

# backendリポジトリのpublish_only実行でpushした同一commit SHAのイメージを指定する。
initial_api_image     = "asia-northeast1-docker.pkg.dev/replace-with-project-id/stock-registry/backend:replace-with-git-sha"
initial_batch_image   = "asia-northeast1-docker.pkg.dev/replace-with-project-id/stock-registry/batch:replace-with-git-sha"
initial_migrate_image = "asia-northeast1-docker.pkg.dev/replace-with-project-id/stock-registry/migrate:replace-with-git-sha"

cors_allowed_origins   = ["https://www.example.com"]
cookie_domain          = "example.com"
api_max_instance_count = 3

# Cloud Run作成後、API独自ドメインを使う場合に有効化する。
# restrict_api_to_load_balancerはDNS・証明書・疎通確認後にtrueへ変更する。
enable_api_domain             = false
api_domain                    = "api.example.com"
restrict_api_to_load_balancer = false

# OAuth credentialのSecret versionを投入してからtrueへ変更する。
enable_oauth                        = false
oauth_frontend_redirect_url         = "https://www.example.com"

# 新規環境の初回applyではfalseにする。Secret versionと初回イメージを用意してからtrueへ変更する。
enable_cloud_run = false
